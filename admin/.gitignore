# Admin panel (a web app; the framework is not chosen yet, so this covers the common ones)

# Dependencies. The lock file is committed on purpose.
node_modules/

# Secrets. Never commit them. Only a template such as .env.example is kept.
.env
.env.*
!.env.example

# Build output
dist/
build/
out/
.next/
.nuxt/
.output/
.svelte-kit/
.vite/
.parcel-cache/
.cache/
.turbo/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/

# TypeScript incremental build info
*.tsbuildinfo

# Keys and certificates
*.pem
*.key
