# HerCare Admin Panel Configuration Template
# Copy this file to .env for local environment configuration

# Base API endpoint for admin routes
# Development with Vite proxy: /api/admin
# Standalone or direct API URL: http://localhost:5000/api/admin
VITE_API_BASE_URL=/api/admin

# Pre-filled admin credentials hint for development convenience
VITE_DEFAULT_ADMIN_EMAIL=admin@hercare.local
VITE_DEFAULT_ADMIN_PASSWORD=your_admin_password_here
