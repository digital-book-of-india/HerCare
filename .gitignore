# Dependencies
node_modules/
.pnp
.pnp.js
# Lock files ARE committed inside backend/, admin/ and mobile/ (they make installs reproducible, and
# `npm ci` needs them). Only the empty stub at the repository root is ignored.
/package-lock.json

# Environment Variables (secrets). Every .env* file is ignored; only the template is kept.
.env
.env.*
!.env.example

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Mobile - Android / iOS & Frameworks
android/.gradle
android/app/build
android/build
ios/Pods
ios/build
*.xcworkspace
*.xcuserdatad
.flutter-plugins
.flutter-plugins-dependencies
.dart_tool/

# Python (if backend is in Python)
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo

# OS generated
.DS_Store
Thumbs.db

# Keys, certificates and signing material
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks

# Database backups and exports hold private health data: never commit them
*.archive
*.bson
*.dump
dump/
hercare-*.gz
hercare-export-*.json

# Test and coverage output
coverage/
.nyc_output/
