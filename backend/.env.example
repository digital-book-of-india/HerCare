NODE_ENV=development
PORT=5000

MONGODB_URI=mongodb://127.0.0.1:27017/hercare

# Comma-separated list of allowed origins. Leave empty for a native mobile app (it needs no CORS).
CORS_ORIGIN=

# How many reverse proxies (load balancer, nginx, Cloudflare) sit in front of the server.
# Production behind one proxy: 1. Without it every user looks like one IP and shares one rate limit.
TRUST_PROXY=

# Signs HerCare's own admin tokens (32+ random characters; must differ from DBI_JWT_SECRET)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_JWT_EXPIRES_IN=8h

# Must equal the main DBI app's JWT_SECRET: HerCare uses it to verify DBI user tokens
DBI_JWT_SECRET=
# Optional: which kinds of DBI account may use HerCare, by the "role" in their token (comma-separated, e.g. user).
# DBI also has business, partner and admin accounts. Empty = every kind is accepted.
DBI_ALLOWED_ROLES=

# 32 bytes as 64 hex characters (generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# BACK THIS UP separately from the database: without it every encrypted note is unreadable.
ENCRYPTION_KEY=
# Names the key. It is stored with every encrypted note. Use a new id (k2, k3, ...) when you change the key.
ENCRYPTION_KEY_ID=k1
# Retired keys that must stay readable until `npm run rotate-key` has re-encrypted everything and old
# backups have expired. Format: id:key,id:key   e.g. k1:<64 hex>. See docs/key-rotation.md.
ENCRYPTION_KEYS_OLD=

# Predefined admin account (not stored in the database). 12+ characters in production.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Change after restoring the database from a backup: phones then send all their data again.
DATA_EPOCH=1

# Optional rate limits per 15 minutes (defaults shown). The API tests set their own.
# RATE_LIMIT=600          per IP
# USER_RATE_LIMIT=300     per signed-in user
# AUTH_RATE_LIMIT=5       failed admin logins
